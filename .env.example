# ============================================
# Django Core Settings
# ============================================

# 🔐 مفتاح الأمان السري (يجب أن يكون قوياً وفريداً)
# لإنشاء مفتاح جديد: 
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here-32-Characters-Minimum

# وضع التصحيح (True في التطوير، False في الإنتاج)
DEBUG=True

# النطاقات المسموح بها (افصل بينها بفواصل)
# للتطوير المحلي
ALLOWED_HOSTS=localhost,127.0.0.1
# للإنتاج: ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# ============================================
# PayPal Settings
# ============================================

# وضع PayPal (sandbox للتجربة، live للإنتاج)
PAYPAL_MODE=sandbox

# العملة المستخدمة (USD, EUR, EGP, SAR, إلخ)
PAYPAL_CURRENCY=EGP

# معرف التطبيق من PayPal Developer Dashboard
PAYPAL_CLIENT_ID=your-paypal-client-id

# المفتاح السري من PayPal
PAYPAL_CLIENT_SECRET=your-paypal-client-secret

# معرف الـ Webhook من PayPal (للاستماع إلى إشعارات الدفع)
PAYPAL_WEBHOOK_ID=your-webhook-id

# ============================================
# Email Settings (Gmail Example)
# ============================================

# نوع خلفية البريد (smtp للإنتاج)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# خادم البريد (Gmail)
EMAIL_HOST=smtp.gmail.com

# منفذ البريد (587 لـ TLS)
EMAIL_PORT=587

# استخدام TLS
EMAIL_USE_TLS=True

# بريدك الإلكتروني
EMAIL_HOST_USER=your-email@gmail.com

# كلمة مرور التطبيق (App Password) - ليست كلمة مرور الحساب
# لإنشاء App Password: Google Account → Security → App passwords
EMAIL_HOST_PASSWORD=your-16-character-app-password

# البريد الذي سيظهر كمرسل
DEFAULT_FROM_EMAIL=your-email@gmail.com

# ============================================
# Session Settings (اختياري)
# ============================================

# مدة الجلسة بالثواني (افتراضي: أسبوعين = 1209600 ثانية)
# SESSION_COOKIE_AGE=1209600